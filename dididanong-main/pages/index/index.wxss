/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.hero {
  background-color: #4CAF50;
  padding: 80rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 32rpx;
}

.menu-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-item.disabled {
  opacity: 0.5;
}

.menu-icon {
  font-size: 60rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
