/* pages/lbs/lbs.wxss */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 页面标题 */
.header {
  padding: 24rpx 32rpx 12rpx;
  background-color: #4CAF50;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

/* 地图 */
.map-container {
  width: 100%;
  height: 480rpx;
}

.map {
  width: 100%;
  height: 100%;
}

/* 位置信息卡片 */
.location-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.loading-box,
.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.loading-icon,
.error-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.loading-text,
.error-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.retry-btn {
  margin-top: 20rpx;
  background-color: #4CAF50;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 12rpx 48rpx;
  line-height: 1.5;
}

.info-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

/* 操作按钮 */
.action-group {
  display: flex;
  gap: 24rpx;
  margin: 24rpx 24rpx 0;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 48rpx;
  padding: 20rpx 0;
  line-height: 1.5;
  border: none;
}

.action-btn.primary {
  background-color: #4CAF50;
  color: #fff;
}

.action-btn.secondary {
  background-color: #fff;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
}

/* 附近服务区域 */
.nearby-section {
  margin: 24rpx 24rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  padding: 0 32rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

/* 关键词标签 */
.keyword-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.keyword-tab {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  background-color: #f5f5f5;
  color: #666;
  border: 1rpx solid transparent;
}

.keyword-tab.active {
  background-color: #e8f5e9;
  color: #4CAF50;
  border-color: #4CAF50;
}

/* 附近列表 */
.nearby-loading,
.nearby-empty {
  padding: 40rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.nearby-list {
  display: flex;
  flex-direction: column;
}

.nearby-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.nearby-item:last-child {
  border-bottom: none;
}

.nearby-item-left {
  flex: 1;
  margin-right: 16rpx;
}

.nearby-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.nearby-address {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.nearby-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.nearby-distance {
  font-size: 26rpx;
  color: #4CAF50;
}

.nearby-nav {
  font-size: 24rpx;
  color: #fff;
  background-color: #4CAF50;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}
